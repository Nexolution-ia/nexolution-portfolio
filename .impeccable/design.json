  "narrative": {
    "northStar": "Mesa de projetos",
    "overview": "A Mesa de projetos apresenta software com clareza e presença: tipografia Manrope pesada, fundo branco, azul-marinho da Nexolution nos planos de destaque e ciano como sinal de identidade. A densidade maior fica dentro das demonstrações; o restante da página preserva espaço para leitura e exploração.\n\nA identidade usa contraste de escala e cor, sem sombras decorativas. Revelações pontuais de título, painel e projetos acompanham a leitura; movimento reduzido mantém tudo imediatamente visível. Exemplos conceituais permanecem identificados; imagens de trabalhos reais dependem das mídias fornecidas ou autorizadas pelo usuário.",
    "keyCharacteristics": [
      "Manrope pesada e títulos compactos.",
      "Azul-marinho e ciano da marca sobre fundo branco.",
      "Divisórias finas, controles precisos e superfícies planas.",
      "Demonstrações interativas com contexto explícito."
    ],
    "rules": [
      {
        "name": "The Flat Surface Rule",
        "body": "Use superfícies e divisórias para separar conteúdo, preservando a ausência de sombras da implementação.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do manter títulos fortes, com peso 800 e espaçamento negativo.",
      "Do usar divisórias e mudança de superfície para organizar a informação.",
      "Do preservar estados de foco visíveis e respeitar movimento reduzido.",
      "Do colocar segmento e categoria na metadata abaixo do visual de projeto.",
      "Do identificar exemplos conceituais e usar mídias reais autorizadas ao apresentar trabalhos entregues."
    ],
    "donts": [
      "Don't transformar exemplos ilustrativos em alegações de entrega ou resultados confirmados.",
      "Don't adicionar sombras decorativas a componentes planos.",
      "Don't esconder navegação essencial em telas pequenas; reorganize-a."
    ]
  }
